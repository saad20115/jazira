# ============================================================================
# Local PostgreSQL 18 Container Initialization (docker-compose.dev.yml)
# ============================================================================

# Host loopback port mapped to container port 5432 (bound to 127.0.0.1 only)
POSTGRES_PORT=5434

# Container superuser name (used only for DB initialization & healthchecks, never by the app)
POSTGRES_USER=CHANGE_ME_PG_SUPERUSER

# Container superuser password (generate a strong random password)
POSTGRES_PASSWORD=CHANGE_ME_PG_SUPERUSER_PASSWORD

# Primary database initialized by the container
POSTGRES_DB=aljazira_dev

# Dedicated non-superuser role used by the Next.js / Payload application (D1)
APP_DB_USER=CHANGE_ME_APP_DB_USER

# Password for the dedicated non-superuser application role
APP_DB_PASSWORD=CHANGE_ME_APP_DB_PASSWORD

# Development database name owned by APP_DB_USER
APP_DB_NAME=aljazira_dev

# Isolated database name for integration tests (owned by APP_DB_USER)
APP_TEST_DB_NAME=aljazira_test

# ============================================================================
# Application Runtime Environment (validated at startup by src/env.ts — S1/S2)
# ============================================================================

# PostgreSQL connection URI using the dedicated non-superuser role (D1)
DATABASE_URL=postgresql://CHANGE_ME_APP_DB_USER:CHANGE_ME_APP_DB_PASSWORD@127.0.0.1:5434/aljazira_dev

# PostgreSQL connection URI for integration tests (never points to the dev database)
TEST_DATABASE_URL=postgresql://CHANGE_ME_APP_DB_USER:CHANGE_ME_APP_DB_PASSWORD@127.0.0.1:5434/aljazira_test

# Canonical public base URL of the application (used for Payload serverURL, CORS, and CSRF — H1)
SERVER_URL=http://localhost:3000

# Payload CMS secret ( MUST be >= 48 random characters; generate with: openssl rand -base64 48 )
PAYLOAD_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48_PAYLOAD_SECRET

# Secret salt for hashing client IPs ( MUST be >= 48 random characters and differ from PAYLOAD_SECRET; generate with: openssl rand -base64 48 )
IP_HASH_SALT=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48_IP_HASH_SALT

# Absolute filesystem paths for uploaded media, video storage, and in-flight upload temp files outside public/
# (default to <cwd>/media, <cwd>/videos, and <os.tmpdir()>/aljazira-uploads in development; in production Docker where /tmp is tmpfs RAM, mount UPLOAD_TMP_DIR on disk — R-18 / P6-T1)
# MEDIA_DIR=/var/lib/aljazira/media
# VIDEOS_DIR=/var/lib/aljazira/videos
# UPLOAD_TMP_DIR=/var/lib/aljazira/tmp

# ============================================================================
# Local SMTP Catcher (Mailpit in docker-compose.dev.yml — A5)
# ============================================================================
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_FROM_ADDRESS=no-reply@aljazira.co
SMTP_FROM_NAME=Al Jazira for Imdad Smart Co.
