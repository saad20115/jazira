tests/int/p2-t4.int.test.ts:624:  it('enforces slug uniqueness, required status with no default (R-9), field constraints, draft relationship/enum validation returning 400 (R-6), and media deletion guard across locales and richText upload nodes (R-7)', async () => {
tests/int/p2-t4.int.test.ts:625:    // 0. Publishing without `status` fails with 400 (no silent 'completed' default) (R-9)
tests/int/p2-t4.int.test.ts:626:    const missingStatusRes = await callJsonApi('POST', '/api/projects?locale=en', {
tests/int/p2-t4.int.test.ts:627:      cookie: editorCookie,
tests/int/p2-t4.int.test.ts:628:      body: {
tests/int/p2-t4.int.test.ts:629:        title: 'Project Without Execution Status',
tests/int/p2-t4.int.test.ts:630:        category: 'data-center',
