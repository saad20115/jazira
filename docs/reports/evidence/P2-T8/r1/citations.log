tests/int/p2-t4.int.test.ts:437:  it('supports scheduled publishing via Payload jobs queue (schedulePublish: true): transitions a draft project to published when the scheduled time arrives', async () => {
tests/int/p2-t4.int.test.ts:438:    const createScheduledDraftRes = await callJsonApi('POST', '/api/projects?locale=ar', {
tests/int/p2-t4.int.test.ts:439:      cookie: editorCookie,
tests/int/p2-t4.int.test.ts:440:      body: {
tests/int/p2-t4.int.test.ts:441:        title: 'مشروع مستودعات الإمداد المجدول للنشر',
tests/int/p2-t4.int.test.ts:442:        category: 'fire-fighting',
tests/int/p2-t4.int.test.ts:443:        location: 'جدة',
tests/int/p2-t4.int.test.ts:444:        status: 'completed',
tests/int/p2-t4.int.test.ts:445:        coverImage: uploadedMediaId,
tests/int/p2-t4.int.test.ts:446:        _status: 'draft',
tests/int/p2-t4.int.test.ts:447:      },
tests/int/p2-t4.int.test.ts:448:    })
tests/int/p2-t4.int.test.ts:449:    expect(createScheduledDraftRes.status).toBe(201)
tests/int/p2-t4.int.test.ts:450:    const scheduledId = (createScheduledDraftRes.data.doc as { id: number | string }).id
tests/int/p2-t4.int.test.ts:452:    // Queue a schedulePublish job 350ms in the future
tests/int/p2-t4.int.test.ts:453:    const waitUntil = new Date(Date.now() + 350)
tests/int/p2-t4.int.test.ts:454:    const scheduleInput: Record<string, unknown> = {
tests/int/p2-t4.int.test.ts:455:      type: 'publish',
tests/int/p2-t4.int.test.ts:456:      doc: {
tests/int/p2-t4.int.test.ts:457:        relationTo: 'projects',
tests/int/p2-t4.int.test.ts:458:        value: String(scheduledId),
tests/int/p2-t4.int.test.ts:459:      },
tests/int/p2-t4.int.test.ts:460:      user: {
tests/int/p2-t4.int.test.ts:461:        relationTo: 'users',
tests/int/p2-t4.int.test.ts:462:        value: Number(adminUserId),
tests/int/p2-t4.int.test.ts:463:      },
tests/int/p2-t4.int.test.ts:464:    }
tests/int/p2-t4.int.test.ts:465:    await payload.jobs.queue({
tests/int/p2-t4.int.test.ts:466:      task: 'schedulePublish',
tests/int/p2-t4.int.test.ts:467:      waitUntil,
tests/int/p2-t4.int.test.ts:468:      input: scheduleInput,
tests/int/p2-t4.int.test.ts:469:    })
tests/int/p2-t4.int.test.ts:471:    // Running jobs BEFORE waitUntil does not publish the draft
tests/int/p2-t4.int.test.ts:472:    await payload.jobs.run()
tests/int/p2-t4.int.test.ts:473:    const anonBeforeTime = await callJsonApi('GET', `/api/projects/${String(scheduledId)}`)
tests/int/p2-t4.int.test.ts:474:    expect(anonBeforeTime.status).toBe(404)
tests/int/p2-t4.int.test.ts:476:    // Wait until past waitUntil and run the jobs queue
tests/int/p2-t4.int.test.ts:477:    await new Promise((resolve) => setTimeout(resolve, 450))
tests/int/p2-t4.int.test.ts:478:    const runResult = await payload.jobs.run()
tests/int/p2-t4.int.test.ts:479:    expect(runResult.jobStatus).toBeDefined()
tests/int/p2-t4.int.test.ts:481:    // Now the project is published and visible to anonymous readers
tests/int/p2-t4.int.test.ts:482:    const anonAfterTime = await callJsonApi('GET', `/api/projects/${String(scheduledId)}?locale=ar`)
tests/int/p2-t4.int.test.ts:483:    expect(anonAfterTime.status).toBe(200)
tests/int/p2-t4.int.test.ts:484:    expect(anonAfterTime.data._status).toBe('published')
tests/int/p2-t4.int.test.ts:485:    expect(anonAfterTime.data.title).toBe('مشروع مستودعات الإمداد المجدول للنشر')
tests/int/p2-t4.int.test.ts:486:  })
