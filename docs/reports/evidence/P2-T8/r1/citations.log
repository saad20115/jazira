tests/int/p1-t3.int.test.ts:547:        token: adminToken,
tests/int/p1-t3.int.test.ts:548:      },
tests/int/p1-t3.int.test.ts:549:    )
tests/int/p1-t3.int.test.ts:550:    expect(adminRevoke.status).toBe(200)
tests/int/p1-t3.int.test.ts:552:    const afterAdminRevokeProtected = await callJsonApi('GET', '/api/users', {
tests/int/p1-t3.int.test.ts:553:      token: token2,
tests/int/p1-t3.int.test.ts:554:    })
tests/int/p1-t3.int.test.ts:555:    expect(afterAdminRevokeProtected.status).toBe(403)
tests/int/p1-t3.int.test.ts:557:    const afterAdminRevokeRefresh = await callJsonApi('POST', '/api/users/refresh-token', {
