tests/int/p1-t3.int.test.ts:388:  it('locks the account after 5 failed login attempts for 15 minutes and refuses the correct password while locked (A1)', async () => {
tests/int/p1-t3.int.test.ts:389:    await payload.create({
tests/int/p1-t3.int.test.ts:390:      collection: 'users',
tests/int/p1-t3.int.test.ts:391:      data: {
tests/int/p1-t3.int.test.ts:392:        name: 'Lockout User',
tests/int/p1-t3.int.test.ts:393:        email: 'lockout@aljazira.co',
tests/int/p1-t3.int.test.ts:394:        password: 'Strong!LockoutPass#2026',
tests/int/p1-t3.int.test.ts:395:        role: 'editor',
tests/int/p1-t3.int.test.ts:396:      },
tests/int/p1-t3.int.test.ts:397:    })
tests/int/p1-t3.int.test.ts:399:    for (let attempt = 1; attempt <= 5; attempt++) {
tests/int/p1-t3.int.test.ts:400:      const wrongRes = await callJsonApi('POST', '/api/users/login', {
tests/int/p1-t3.int.test.ts:401:        body: {
tests/int/p1-t3.int.test.ts:402:          email: 'lockout@aljazira.co',
tests/int/p1-t3.int.test.ts:403:          password: `Wrong!PassAttempt#${String(attempt)}`,
tests/int/p1-t3.int.test.ts:404:        },
tests/int/p1-t3.int.test.ts:405:      })
tests/int/p1-t3.int.test.ts:406:      expect(wrongRes.status).toBe(401)
tests/int/p1-t3.int.test.ts:407:    }
tests/int/p1-t3.int.test.ts:409:    // 6th wrong password triggers lockout
tests/int/p1-t3.int.test.ts:410:    const sixthWrong = await callJsonApi('POST', '/api/users/login', {
tests/int/p1-t3.int.test.ts:411:      body: {
tests/int/p1-t3.int.test.ts:412:        email: 'lockout@aljazira.co',
tests/int/p1-t3.int.test.ts:413:        password: 'Wrong!PassAttempt#6',
tests/int/p1-t3.int.test.ts:414:      },
tests/int/p1-t3.int.test.ts:415:    })
tests/int/p1-t3.int.test.ts:416:    expect(sixthWrong.status).toBe(401)
tests/int/p1-t3.int.test.ts:418:    // Correct password is now refused while the account is locked
tests/int/p1-t3.int.test.ts:419:    const correctWhileLocked = await callJsonApi('POST', '/api/users/login', {
tests/int/p1-t3.int.test.ts:420:      body: {
tests/int/p1-t3.int.test.ts:421:        email: 'lockout@aljazira.co',
tests/int/p1-t3.int.test.ts:422:        password: 'Strong!LockoutPass#2026',
tests/int/p1-t3.int.test.ts:423:      },
tests/int/p1-t3.int.test.ts:424:    })
tests/int/p1-t3.int.test.ts:425:    expect(correctWhileLocked.status).toBe(401)
tests/int/p1-t3.int.test.ts:427:    const lockedDoc = await payload.db.findOne({
tests/int/p1-t3.int.test.ts:428:      collection: 'users',
tests/int/p1-t3.int.test.ts:429:      where: {
tests/int/p1-t3.int.test.ts:430:        email: { equals: 'lockout@aljazira.co' },
tests/int/p1-t3.int.test.ts:431:      },
tests/int/p1-t3.int.test.ts:432:    })
tests/int/p1-t3.int.test.ts:433:    const lockUntilStr = (lockedDoc as { lockUntil?: string } | null)?.lockUntil
tests/int/p1-t3.int.test.ts:434:    expect(typeof lockUntilStr).toBe('string')
tests/int/p1-t3.int.test.ts:435:    const lockRemainingMs = new Date(lockUntilStr ?? '').getTime() - Date.now()
tests/int/p1-t3.int.test.ts:436:    // Should be close to 15 minutes (between 14 and 15.1 minutes)
tests/int/p1-t3.int.test.ts:437:    expect(lockRemainingMs).toBeGreaterThan(14 * 60 * 1000)
tests/int/p1-t3.int.test.ts:438:    expect(lockRemainingMs).toBeLessThanOrEqual(15 * 60 * 1000 + 5000)
tests/int/p1-t3.int.test.ts:439:  })
tests/int/p1-t3.int.test.ts:441:  it('revokes JWT access immediately on user logout and on admin-forced session removal (A2)', async () => {
tests/int/p1-t3.int.test.ts:442:    const sessionUser = await payload.create({
tests/int/p1-t3.int.test.ts:443:      collection: 'users',
tests/int/p1-t3.int.test.ts:444:      data: {
tests/int/p1-t3.int.test.ts:445:        name: 'Session User',
tests/int/p1-t3.int.test.ts:446:        email: 'session@aljazira.co',
tests/int/p1-t3.int.test.ts:447:        password: 'Strong!SessionPass#2026',
tests/int/p1-t3.int.test.ts:448:        role: 'editor',
tests/int/p1-t3.int.test.ts:449:      },
tests/int/p1-t3.int.test.ts:450:    })
tests/int/p1-t3.int.test.ts:452:    // 1. Normal login -> token works -> logout -> old token rejected
tests/int/p1-t3.int.test.ts:453:    const login1 = await callJsonApi('POST', '/api/users/login', {
tests/int/p1-t3.int.test.ts:454:      body: {
tests/int/p1-t3.int.test.ts:455:        email: 'session@aljazira.co',
tests/int/p1-t3.int.test.ts:456:        password: 'Strong!SessionPass#2026',
tests/int/p1-t3.int.test.ts:457:      },
tests/int/p1-t3.int.test.ts:458:    })
tests/int/p1-t3.int.test.ts:459:    expect(login1.status).toBe(200)
tests/int/p1-t3.int.test.ts:460:    const token1 = login1.json.token as string
tests/int/p1-t3.int.test.ts:462:    // Verify Set-Cookie header has HttpOnly and SameSite=Strict (A3)
tests/int/p1-t3.int.test.ts:463:    const setCookieHeader = login1.headers.get('set-cookie') ?? ''
tests/int/p1-t3.int.test.ts:464:    expect(setCookieHeader).toContain('HttpOnly')
tests/int/p1-t3.int.test.ts:465:    expect(setCookieHeader).toContain('SameSite=Strict')
tests/int/p1-t3.int.test.ts:467:    const beforeLogout = await callJsonApi('GET', '/api/users', {
tests/int/p1-t3.int.test.ts:468:      token: token1,
tests/int/p1-t3.int.test.ts:469:    })
tests/int/p1-t3.int.test.ts:470:    expect(beforeLogout.status).toBe(200)
tests/int/p1-t3.int.test.ts:472:    const logoutRes = await callJsonApi('POST', '/api/users/logout', {
tests/int/p1-t3.int.test.ts:473:      token: token1,
tests/int/p1-t3.int.test.ts:474:    })
tests/int/p1-t3.int.test.ts:475:    expect(logoutRes.status).toBe(200)
tests/int/p1-t3.int.test.ts:477:    // Old token after logout is rejected on protected endpoint (403), refresh-token (403), and /api/users/me returns user: null
tests/int/p1-t3.int.test.ts:478:    const afterLogoutProtected = await callJsonApi('GET', '/api/users', {
tests/int/p1-t3.int.test.ts:479:      token: token1,
tests/int/p1-t3.int.test.ts:480:    })
tests/int/p1-t3.int.test.ts:481:    expect(afterLogoutProtected.status).toBe(403)
tests/int/p1-t3.int.test.ts:483:    const afterLogoutRefresh = await callJsonApi('POST', '/api/users/refresh-token', {
tests/int/p1-t3.int.test.ts:484:      token: token1,
tests/int/p1-t3.int.test.ts:485:    })
tests/int/p1-t3.int.test.ts:486:    expect(afterLogoutRefresh.status).toBe(403)
tests/int/p1-t3.int.test.ts:488:    const afterLogoutMe = await callJsonApi('GET', '/api/users/me', {
tests/int/p1-t3.int.test.ts:489:      token: token1,
tests/int/p1-t3.int.test.ts:490:    })
tests/int/p1-t3.int.test.ts:491:    expect(afterLogoutMe.json.user).toBeNull()
tests/int/p1-t3.int.test.ts:493:    // 2. Admin-forced session removal via POST /api/users/:id/revoke-sessions (R-3)
tests/int/p1-t3.int.test.ts:494:    const login2 = await callJsonApi('POST', '/api/users/login', {
tests/int/p1-t3.int.test.ts:495:      body: {
tests/int/p1-t3.int.test.ts:496:        email: 'session@aljazira.co',
tests/int/p1-t3.int.test.ts:497:        password: 'Strong!SessionPass#2026',
tests/int/p1-t3.int.test.ts:498:      },
tests/int/p1-t3.int.test.ts:499:    })
tests/int/p1-t3.int.test.ts:500:    expect(login2.status).toBe(200)
tests/int/p1-t3.int.test.ts:501:    const token2 = login2.json.token as string
tests/int/p1-t3.int.test.ts:503:    const beforeRevoke = await callJsonApi('GET', '/api/users', {
tests/int/p1-t3.int.test.ts:504:      token: token2,
tests/int/p1-t3.int.test.ts:505:    })
tests/int/p1-t3.int.test.ts:506:    expect(beforeRevoke.status).toBe(200)
tests/int/p1-t3.int.test.ts:508:    // Verify arbitrary sessions array in PATCH is ignored and never stored (R-3)
tests/int/p1-t3.int.test.ts:509:    const fabricatedPatch = await callJsonApi('PATCH', `/api/users/${String(sessionUser.id)}`, {
tests/int/p1-t3.int.test.ts:510:      token: adminToken,
tests/int/p1-t3.int.test.ts:511:      body: {
tests/int/p1-t3.int.test.ts:512:        sessions: [
tests/int/p1-t3.int.test.ts:513:          {
tests/int/p1-t3.int.test.ts:514:            id: 'fabricated-by-admin',
tests/int/p1-t3.int.test.ts:515:            expiresAt: '2099-01-01T00:00:00.000Z',
tests/int/p1-t3.int.test.ts:516:          },
tests/int/p1-t3.int.test.ts:517:        ],
tests/int/p1-t3.int.test.ts:518:      },
tests/int/p1-t3.int.test.ts:519:    })
tests/int/p1-t3.int.test.ts:520:    expect(fabricatedPatch.status).toBe(200)
tests/int/p1-t3.int.test.ts:522:    const userAfterFabricatedPatch = (await payload.db.findOne({
tests/int/p1-t3.int.test.ts:523:      collection: 'users',
tests/int/p1-t3.int.test.ts:524:      where: {
tests/int/p1-t3.int.test.ts:525:        id: { equals: sessionUser.id },
tests/int/p1-t3.int.test.ts:526:      },
tests/int/p1-t3.int.test.ts:527:    })) as { sessions?: Array<{ id: string }> } | null
tests/int/p1-t3.int.test.ts:528:    const sessionIdsAfterPatch = (userAfterFabricatedPatch?.sessions ?? []).map((s) => s.id)
tests/int/p1-t3.int.test.ts:529:    expect(sessionIdsAfterPatch).not.toContain('fabricated-by-admin')
tests/int/p1-t3.int.test.ts:530:    expect(sessionIdsAfterPatch.length).toBe(1)
tests/int/p1-t3.int.test.ts:532:    // Editor cannot call POST /api/users/:id/revoke-sessions -> 403
tests/int/p1-t3.int.test.ts:533:    const editorRevokeAttempt = await callJsonApi(
tests/int/p1-t3.int.test.ts:534:      'POST',
tests/int/p1-t3.int.test.ts:535:      `/api/users/${String(sessionUser.id)}/revoke-sessions`,
tests/int/p1-t3.int.test.ts:536:      {
tests/int/p1-t3.int.test.ts:537:        token: editorToken,
tests/int/p1-t3.int.test.ts:538:      },
tests/int/p1-t3.int.test.ts:539:    )
tests/int/p1-t3.int.test.ts:540:    expect(editorRevokeAttempt.status).toBe(403)
tests/int/p1-t3.int.test.ts:542:    // Admin calls POST /api/users/:id/revoke-sessions -> 200 and clears sessions
tests/int/p1-t3.int.test.ts:543:    const adminRevoke = await callJsonApi(
tests/int/p1-t3.int.test.ts:544:      'POST',
tests/int/p1-t3.int.test.ts:545:      `/api/users/${String(sessionUser.id)}/revoke-sessions`,
