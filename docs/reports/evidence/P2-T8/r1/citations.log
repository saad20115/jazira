tests/int/p1-t3.int.test.ts:568:  it('refuses deleting or demoting the last admin user, while allowing deleting a second admin (R-2)', async () => {
tests/int/p1-t3.int.test.ts:569:    // 1. Refuse demoting the last admin via REST API
tests/int/p1-t3.int.test.ts:570:    const demoteRes = await callJsonApi('PATCH', `/api/users/${String(adminId)}`, {
tests/int/p1-t3.int.test.ts:571:      token: adminToken,
tests/int/p1-t3.int.test.ts:572:      body: {
tests/int/p1-t3.int.test.ts:573:        role: 'editor',
tests/int/p1-t3.int.test.ts:574:      },
tests/int/p1-t3.int.test.ts:575:    })
tests/int/p1-t3.int.test.ts:576:    expect(demoteRes.status).toBe(400)
tests/int/p1-t3.int.test.ts:577:    expect(JSON.stringify(demoteRes.json)).toContain('Cannot demote the last admin user')
tests/int/p1-t3.int.test.ts:579:    // 2. Refuse deleting the last admin via REST API
tests/int/p1-t3.int.test.ts:580:    const deleteRes = await callJsonApi('DELETE', `/api/users/${String(adminId)}`, {
tests/int/p1-t3.int.test.ts:581:      token: adminToken,
tests/int/p1-t3.int.test.ts:582:    })
tests/int/p1-t3.int.test.ts:583:    expect(deleteRes.status).toBe(400)
tests/int/p1-t3.int.test.ts:584:    expect(JSON.stringify(deleteRes.json)).toContain('Cannot delete the last admin user')
tests/int/p1-t3.int.test.ts:586:    // Verify the admin still exists with role === 'admin'
tests/int/p1-t3.int.test.ts:587:    const adminStillExists = await payload.findByID({
tests/int/p1-t3.int.test.ts:588:      collection: 'users',
tests/int/p1-t3.int.test.ts:589:      id: adminId,
tests/int/p1-t3.int.test.ts:590:    })
tests/int/p1-t3.int.test.ts:591:    expect(adminStillExists.role).toBe('admin')
tests/int/p1-t3.int.test.ts:593:    // 3. Create a second admin, verify demoting and deleting the second admin succeeds while 1 admin remains
tests/int/p1-t3.int.test.ts:594:    const secondAdminRes = await callJsonApi('POST', '/api/users', {
tests/int/p1-t3.int.test.ts:595:      token: adminToken,
tests/int/p1-t3.int.test.ts:596:      body: {
tests/int/p1-t3.int.test.ts:597:        name: 'Second Admin',
tests/int/p1-t3.int.test.ts:598:        email: 'second-admin@aljazira.co',
tests/int/p1-t3.int.test.ts:599:        password: 'Strong!SecondAdmin#2026',
tests/int/p1-t3.int.test.ts:600:        role: 'admin',
tests/int/p1-t3.int.test.ts:601:      },
tests/int/p1-t3.int.test.ts:602:    })
tests/int/p1-t3.int.test.ts:603:    expect(secondAdminRes.status).toBe(201)
tests/int/p1-t3.int.test.ts:604:    const secondAdminId = (secondAdminRes.json.doc as { id: number | string }).id
tests/int/p1-t3.int.test.ts:606:    const deleteSecondAdminRes = await callJsonApi(
tests/int/p1-t3.int.test.ts:607:      'DELETE',
tests/int/p1-t3.int.test.ts:608:      `/api/users/${String(secondAdminId)}`,
tests/int/p1-t3.int.test.ts:609:      {
tests/int/p1-t3.int.test.ts:610:        token: adminToken,
tests/int/p1-t3.int.test.ts:611:      },
tests/int/p1-t3.int.test.ts:612:    )
tests/int/p1-t3.int.test.ts:613:    expect(deleteSecondAdminRes.status).toBe(200)
