tests/int/p2-t6.int.test.ts:593:  it('normalizes phone inputs (0573534185, 057 353 4185, 00966 57 353 4185, +966 57 353 4185) to canonical E.164 +966573534185 (R-3, R-12), preserves read-only serviceTitle snapshot when the referenced service is deleted (R-4), and allows editors to read only id + name of other users (R-5, R-11)', async () => {
tests/int/p2-t6.int.test.ts:594:    // R-3: Rejects 00966 with wrong national digit count, bare 966573534185 without +, and +111111111111111
tests/int/p2-t6.int.test.ts:595:    for (const invalidPhone of ['009665735341', '966573534185', '+111111111111111']) {
tests/int/p2-t6.int.test.ts:596:      await expect(
tests/int/p2-t6.int.test.ts:597:        payload.create({
tests/int/p2-t6.int.test.ts:598:          collection: 'quote-requests',
tests/int/p2-t6.int.test.ts:599:          overrideAccess: true,
tests/int/p2-t6.int.test.ts:600:          data: {
tests/int/p2-t6.int.test.ts:601:            name: 'اختبار رقم هاتف غير صالح',
tests/int/p2-t6.int.test.ts:602:            email: 'phone-check@example.sa',
tests/int/p2-t6.int.test.ts:603:            phone: invalidPhone,
tests/int/p2-t6.int.test.ts:604:            locale: 'ar',
tests/int/p2-t6.int.test.ts:605:            consent: true,
tests/int/p2-t6.int.test.ts:606:            status: 'new',
tests/int/p2-t6.int.test.ts:607:            emailStatus: 'pending',
tests/int/p2-t6.int.test.ts:608:          },
tests/int/p2-t6.int.test.ts:609:        }),
tests/int/p2-t6.int.test.ts:610:      ).rejects.toThrow()
tests/int/p2-t6.int.test.ts:611:    }
tests/int/p2-t6.int.test.ts:613:    // R-12 & R-16: All valid KSA local and international formats (including +966 05... and 00 966 ...) store canonical E.164 (+966573534185)
tests/int/p2-t6.int.test.ts:614:    for (const rawPhoneVariant of [
tests/int/p2-t6.int.test.ts:615:      '0573534185',
tests/int/p2-t6.int.test.ts:616:      '057 353 4185',
tests/int/p2-t6.int.test.ts:617:      '00966 57 353 4185',
tests/int/p2-t6.int.test.ts:618:      '00 966 57 353 4185',
tests/int/p2-t6.int.test.ts:619:      '+966 57 353 4185',
tests/int/p2-t6.int.test.ts:620:      '+966 0573534185',
tests/int/p2-t6.int.test.ts:621:      '+966 (57) 353-4185',
tests/int/p2-t6.int.test.ts:622:    ]) {
tests/int/p2-t6.int.test.ts:623:      const createdVariant = await payload.create({
tests/int/p2-t6.int.test.ts:624:        collection: 'quote-requests',
tests/int/p2-t6.int.test.ts:625:        overrideAccess: true,
tests/int/p2-t6.int.test.ts:626:        data: {
tests/int/p2-t6.int.test.ts:627:          name: 'عميل اختبار تطبيع E.164',
tests/int/p2-t6.int.test.ts:628:          email: 'e164-check@example.sa',
tests/int/p2-t6.int.test.ts:629:          phone: rawPhoneVariant,
tests/int/p2-t6.int.test.ts:630:          locale: 'ar',
tests/int/p2-t6.int.test.ts:631:          consent: true,
tests/int/p2-t6.int.test.ts:632:          status: 'new',
