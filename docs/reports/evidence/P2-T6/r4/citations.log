.github/workflows/ci.yml:10:      - main
.github/workflows/ci.yml:12:permissions:
.github/workflows/ci.yml:13:  contents: read
.github/workflows/ci.yml:15:jobs:
.github/workflows/ci.yml:16:  verify:
.github/workflows/ci.yml:17:    name: Verify (Node 24 · Postgres 18 · Mailpit)
.github/workflows/ci.yml:18:    runs-on: ubuntu-latest
.github/workflows/ci.yml:19:    timeout-minutes: 25
.github/workflows/ci.yml:21:    env:
.github/workflows/ci.yml:22:      SMTP_HOST: 127.0.0.1
.github/workflows/ci.yml:23:      SMTP_PORT: '1025'
.github/workflows/ci.yml:24:      MAILPIT_UI_PORT: '8025'
.github/workflows/ci.yml:25:      SMTP_FROM_ADDRESS: no-reply@aljazira.co
.github/workflows/ci.yml:26:      SMTP_FROM_NAME: Al Jazira for Imdad Smart Co.
.github/workflows/ci.yml:28:    services:
.github/workflows/ci.yml:29:      postgres:
.github/workflows/ci.yml:30:        image: postgres:18.6@sha256:5486e8fb206952552c7e2eaf2e36e4c7be3cd36b2b396eb41de618aa5664a781
.github/workflows/ci.yml:31:        env:
.github/workflows/ci.yml:32:          POSTGRES_USER: postgres_admin
.github/workflows/ci.yml:33:          POSTGRES_PASSWORD: ci_superuser_bootstrap_pass
.github/workflows/ci.yml:34:          POSTGRES_DB: postgres
.github/workflows/ci.yml:35:          POSTGRES_INITDB_ARGS: --auth-host=scram-sha-256 --auth-local=scram-sha-256
.github/workflows/ci.yml:36:        ports:
.github/workflows/ci.yml:37:          - 127.0.0.1:5432:5432
.github/workflows/ci.yml:38:        options: >-
.github/workflows/ci.yml:39:          --health-cmd="pg_isready -U postgres_admin -d postgres -h 127.0.0.1"
.github/workflows/ci.yml:40:          --health-interval=5s
.github/workflows/ci.yml:41:          --health-timeout=5s
.github/workflows/ci.yml:42:          --health-retries=10
.github/workflows/ci.yml:44:      mailpit:
.github/workflows/ci.yml:45:        image: axllent/mailpit:v1.31.6@sha256:23fe39e81bde596a918000b3135c0f85dc8bb4c9ea6be274b051143f3e300387
.github/workflows/ci.yml:46:        ports:
.github/workflows/ci.yml:47:          - 127.0.0.1:1025:1025
.github/workflows/ci.yml:48:          - 127.0.0.1:8025:8025
.github/workflows/ci.yml:50:    steps:
.github/workflows/ci.yml:51:      - name: Checkout repository
.github/workflows/ci.yml:52:        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
.github/workflows/ci.yml:53:        with:
.github/workflows/ci.yml:54:          fetch-depth: 0
.github/workflows/ci.yml:56:      - name: Setup pnpm 10.34.7
.github/workflows/ci.yml:57:        uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
.github/workflows/ci.yml:58:        with:
.github/workflows/ci.yml:59:          version: 10.34.7
.github/workflows/ci.yml:61:      - name: Setup Node.js 24
.github/workflows/ci.yml:62:        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
.github/workflows/ci.yml:63:        with:
.github/workflows/ci.yml:64:          node-version: '24'
.github/workflows/ci.yml:65:          cache: 'pnpm'
.github/workflows/ci.yml:67:      - name: Generate per-run secrets and initialize non-superuser DB role (S1, S2, D1)
.github/workflows/ci.yml:68:        run: |
.github/workflows/ci.yml:69:          set -euo pipefail
.github/workflows/ci.yml:70:          PAYLOAD_SECRET="$(openssl rand -base64 48 | tr -d '\n')"
.github/workflows/ci.yml:71:          IP_HASH_SALT="$(openssl rand -base64 48 | tr -d '\n')"
.github/workflows/ci.yml:72:          APP_DB_PASS="$(openssl rand -hex 24)"
.github/workflows/ci.yml:74:          echo "::add-mask::${PAYLOAD_SECRET}"
.github/workflows/ci.yml:75:          echo "::add-mask::${IP_HASH_SALT}"
.github/workflows/ci.yml:76:          echo "::add-mask::${APP_DB_PASS}"
.github/workflows/ci.yml:78:          PGPASSWORD="ci_superuser_bootstrap_pass" psql -h 127.0.0.1 -U postgres_admin -d postgres -v ON_ERROR_STOP=1 <<SQL
.github/workflows/ci.yml:79:          CREATE ROLE aljazira_app WITH LOGIN PASSWORD '${APP_DB_PASS}' NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION;
.github/workflows/ci.yml:80:          CREATE DATABASE aljazira_dev OWNER aljazira_app;
.github/workflows/ci.yml:81:          CREATE DATABASE aljazira_test OWNER aljazira_app;
.github/workflows/ci.yml:82:          REVOKE ALL ON DATABASE aljazira_dev FROM PUBLIC;
.github/workflows/ci.yml:83:          REVOKE ALL ON DATABASE aljazira_test FROM PUBLIC;
.github/workflows/ci.yml:84:          GRANT ALL PRIVILEGES ON DATABASE aljazira_dev TO aljazira_app;
.github/workflows/ci.yml:85:          GRANT ALL PRIVILEGES ON DATABASE aljazira_test TO aljazira_app;
.github/workflows/ci.yml:86:          SQL
.github/workflows/ci.yml:88:          {
.github/workflows/ci.yml:89:            echo "SERVER_URL=http://localhost:3000"
.github/workflows/ci.yml:90:            echo "PAYLOAD_SECRET=${PAYLOAD_SECRET}"
.github/workflows/ci.yml:91:            echo "IP_HASH_SALT=${IP_HASH_SALT}"
.github/workflows/ci.yml:92:            echo "APP_DB_PASS=${APP_DB_PASS}"
.github/workflows/ci.yml:93:            echo "DATABASE_URL=postgresql://aljazira_app:${APP_DB_PASS}@127.0.0.1:5432/aljazira_dev"
.github/workflows/ci.yml:94:            echo "TEST_DATABASE_URL=postgresql://aljazira_app:${APP_DB_PASS}@127.0.0.1:5432/aljazira_test"
.github/workflows/ci.yml:95:            echo "PAYLOAD_JOBS_AUTORUN=true"
.github/workflows/ci.yml:96:          } >> "$GITHUB_ENV"
.github/workflows/ci.yml:98:      - name: Install dependencies (frozen lockfile)
.github/workflows/ci.yml:99:        run: pnpm install --frozen-lockfile
.github/workflows/ci.yml:101:      - name: Lint
.github/workflows/ci.yml:102:        run: pnpm lint
.github/workflows/ci.yml:104:      - name: Typecheck
.github/workflows/ci.yml:105:        run: pnpm typecheck
.github/workflows/ci.yml:107:      - name: Check formatting
.github/workflows/ci.yml:108:        run: pnpm format:check
.github/workflows/ci.yml:110:      - name: Verify generated Payload types are up to date
.github/workflows/ci.yml:111:        run: |
.github/workflows/ci.yml:112:          set -euo pipefail
.github/workflows/ci.yml:113:          pnpm payload generate:types
.github/workflows/ci.yml:114:          git diff --exit-code src/payload-types.ts
.github/workflows/ci.yml:116:      - name: Run database migrations (up / status / down / up)
.github/workflows/ci.yml:117:        run: |
.github/workflows/ci.yml:118:          pnpm payload migrate
.github/workflows/ci.yml:119:          pnpm payload migrate:status
.github/workflows/ci.yml:120:          pnpm payload migrate:down
.github/workflows/ci.yml:121:          pnpm payload migrate
.github/workflows/ci.yml:122:          pnpm payload migrate:status
.github/workflows/ci.yml:124:      - name: Verify zero Payload migration drift
.github/workflows/ci.yml:125:        run: |
.github/workflows/ci.yml:126:          set -euo pipefail
.github/workflows/ci.yml:127:          OUT="$(echo n | pnpm payload migrate:create ci_drift_check --no-color 2>&1)"
.github/workflows/ci.yml:128:          echo "$OUT"
.github/workflows/ci.yml:129:          echo "$OUT" | grep -Fq "No schema changes detected"
.github/workflows/ci.yml:130:          if [ -n "$(git status --porcelain src/migrations)" ]; then
.github/workflows/ci.yml:131:            echo "ERROR: Uncommitted migration changes detected in src/migrations!" >&2
.github/workflows/ci.yml:132:            exit 1
.github/workflows/ci.yml:133:          fi
.github/workflows/ci.yml:135:      - name: Run unit and integration tests
.github/workflows/ci.yml:136:        run: pnpm test
.github/workflows/ci.yml:138:      - name: Build production bundle and verify zero client secret leakage (S4)
.github/workflows/ci.yml:139:        run: |
.github/workflows/ci.yml:140:          set -euo pipefail
.github/workflows/ci.yml:141:          pnpm build
.github/workflows/ci.yml:142:          if grep -Fq "$PAYLOAD_SECRET" -R .next/static; then
.github/workflows/ci.yml:143:            echo "ERROR: PAYLOAD_SECRET value leaked into .next/static!" >&2
.github/workflows/ci.yml:144:            exit 1
.github/workflows/ci.yml:145:          fi
.github/workflows/ci.yml:146:          if grep -Fq "$IP_HASH_SALT" -R .next/static; then
.github/workflows/ci.yml:147:            echo "ERROR: IP_HASH_SALT value leaked into .next/static!" >&2
.github/workflows/ci.yml:148:            exit 1
.github/workflows/ci.yml:149:          fi
.github/workflows/ci.yml:150:          if grep -Fq "$APP_DB_PASS" -R .next/static; then
.github/workflows/ci.yml:151:            echo "ERROR: Database password leaked into .next/static!" >&2
.github/workflows/ci.yml:152:            exit 1
.github/workflows/ci.yml:153:          fi
.github/workflows/ci.yml:154:          if grep -Fq "__ALJAZIRA_SERVER_ONLY_MODULE_SENTINEL_S4_" -R .next/static; then
.github/workflows/ci.yml:155:            echo "ERROR: Server-only module sentinel leaked into .next/static (R-6)!" >&2
.github/workflows/ci.yml:156:            exit 1
.github/workflows/ci.yml:157:          fi
.github/workflows/ci.yml:159:      - name: Run Playwright e2e smoke tests
.github/workflows/ci.yml:160:        run: pnpm test:e2e
.github/workflows/ci.yml:162:      - name: Audit production dependencies
.github/workflows/ci.yml:163:        run: pnpm audit --prod --audit-level high
.github/workflows/ci.yml:165:      - name: Scan git history with gitleaks (S3)
.github/workflows/ci.yml:166:        run: |
.github/workflows/ci.yml:167:          set -euo pipefail
.github/workflows/ci.yml:168:          GITLEAKS_VERSION="8.24.2"
.github/workflows/ci.yml:169:          GITLEAKS_SHA256="fa0500f6b7e41d28791ebc680f5dd9899cd42b58629218a5f041efa899151a8e"
.github/workflows/ci.yml:170:          curl -sSL "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" -o /tmp/gitleaks.tar.gz
.github/workflows/ci.yml:171:          echo "${GITLEAKS_SHA256}  /tmp/gitleaks.tar.gz" | sha256sum -c -
.github/workflows/ci.yml:172:          tar -xzf /tmp/gitleaks.tar.gz -C /tmp gitleaks
.github/workflows/ci.yml:173:          /tmp/gitleaks git --no-banner --redact --verbose .
