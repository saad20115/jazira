tests/int/p2-t6.int.test.ts:678:    // Phone normalized to canonical E.164 (+966573534185), and serviceTitle snapshot captured
tests/int/p2-t6.int.test.ts:679:    expect(quoteWith00966.phone).toBe('+966573534185')
tests/int/p2-t6.int.test.ts:680:    expect(quoteWith00966.serviceTitle).toBe('أنظمة التيار الخفيف والتحكم الذكي (ELV)')
tests/int/p2-t6.int.test.ts:682:    // R-11: Editor reading the quote request at depth=1 sees the assignee's id and name, but never another user's email, role, or sessions
tests/int/p2-t6.int.test.ts:683:    const quoteDepth1AsEditor = await callJsonApi({
tests/int/p2-t6.int.test.ts:684:      method: 'GET',
