tests/int/p2-t6.int.test.ts:778:  it('enforces Users.access.unlock = isAdmin: editor unlocking another user (existing or unknown email) or self returns 403, anonymous returns 403, and admin unlocking a locked account returns 200 and restores login (R-13)', async () => {
tests/int/p2-t6.int.test.ts:779:    const lockedAdminEmail = 'locked-admin-p2t6@aljazira.co'
tests/int/p2-t6.int.test.ts:780:    const lockedAdminPassword = 'Str0ng!Locked#Pass2026$XyZ'
tests/int/p2-t6.int.test.ts:782:    const lockedAdmin = await payload.create({
tests/int/p2-t6.int.test.ts:783:      collection: 'users',
tests/int/p2-t6.int.test.ts:784:      overrideAccess: true,
tests/int/p2-t6.int.test.ts:785:      data: {
tests/int/p2-t6.int.test.ts:786:        name: 'م. سلطان القحطاني (مدير نظام مقفل)',
tests/int/p2-t6.int.test.ts:787:        email: lockedAdminEmail,
tests/int/p2-t6.int.test.ts:788:        password: lockedAdminPassword,
tests/int/p2-t6.int.test.ts:789:        role: 'admin',
tests/int/p2-t6.int.test.ts:790:      },
tests/int/p2-t6.int.test.ts:791:    })
tests/int/p2-t6.int.test.ts:793:    try {
tests/int/p2-t6.int.test.ts:794:      // 1. Six failed logins lock the admin account (maxLoginAttempts = 5)
tests/int/p2-t6.int.test.ts:795:      for (let i = 0; i < 6; i++) {
tests/int/p2-t6.int.test.ts:796:        const badLogin = await callJsonApi({
tests/int/p2-t6.int.test.ts:797:          method: 'POST',
tests/int/p2-t6.int.test.ts:798:          slugPath: ['users', 'login'],
tests/int/p2-t6.int.test.ts:799:          body: {
tests/int/p2-t6.int.test.ts:800:            email: lockedAdminEmail,
tests/int/p2-t6.int.test.ts:801:            password: `WrongPassword!${String(i)}#2026`,
tests/int/p2-t6.int.test.ts:802:          },
tests/int/p2-t6.int.test.ts:803:        })
tests/int/p2-t6.int.test.ts:804:        expect(badLogin.status).toBe(401)
tests/int/p2-t6.int.test.ts:805:      }
tests/int/p2-t6.int.test.ts:807:      // Confirm account is locked: valid password now fails with 401
tests/int/p2-t6.int.test.ts:808:      const loginWhileLocked = await callJsonApi({
tests/int/p2-t6.int.test.ts:809:        method: 'POST',
tests/int/p2-t6.int.test.ts:810:        slugPath: ['users', 'login'],
tests/int/p2-t6.int.test.ts:811:        body: {
tests/int/p2-t6.int.test.ts:812:          email: lockedAdminEmail,
tests/int/p2-t6.int.test.ts:813:          password: lockedAdminPassword,
tests/int/p2-t6.int.test.ts:814:        },
tests/int/p2-t6.int.test.ts:815:      })
tests/int/p2-t6.int.test.ts:816:      expect(loginWhileLocked.status).toBe(401)
tests/int/p2-t6.int.test.ts:818:      // 2. Anonymous POST /api/users/unlock -> 403
tests/int/p2-t6.int.test.ts:819:      const anonUnlock = await callJsonApi({
tests/int/p2-t6.int.test.ts:820:        method: 'POST',
tests/int/p2-t6.int.test.ts:821:        slugPath: ['users', 'unlock'],
tests/int/p2-t6.int.test.ts:822:        body: { email: lockedAdminEmail },
tests/int/p2-t6.int.test.ts:823:      })
tests/int/p2-t6.int.test.ts:824:      expect(anonUnlock.status).toBe(403)
tests/int/p2-t6.int.test.ts:826:      // 3. Editor unlocking someone else (existing email vs unknown email) -> both 403 with identical error (no email oracle!)
tests/int/p2-t6.int.test.ts:827:      const editorUnlockExisting = await callJsonApi({
tests/int/p2-t6.int.test.ts:828:        method: 'POST',
tests/int/p2-t6.int.test.ts:829:        slugPath: ['users', 'unlock'],
tests/int/p2-t6.int.test.ts:830:        token: editorToken,
tests/int/p2-t6.int.test.ts:831:        body: { email: lockedAdminEmail },
tests/int/p2-t6.int.test.ts:832:      })
tests/int/p2-t6.int.test.ts:833:      const editorUnlockUnknown = await callJsonApi({
tests/int/p2-t6.int.test.ts:834:        method: 'POST',
tests/int/p2-t6.int.test.ts:835:        slugPath: ['users', 'unlock'],
tests/int/p2-t6.int.test.ts:836:        token: editorToken,
tests/int/p2-t6.int.test.ts:837:        body: { email: 'unknown-oracle-probe-p2t6@aljazira.co' },
tests/int/p2-t6.int.test.ts:838:      })
tests/int/p2-t6.int.test.ts:839:      expect(editorUnlockExisting.status).toBe(403)
tests/int/p2-t6.int.test.ts:840:      expect(editorUnlockUnknown.status).toBe(403)
tests/int/p2-t6.int.test.ts:841:      expect(editorUnlockExisting.body).toEqual(editorUnlockUnknown.body)
tests/int/p2-t6.int.test.ts:843:      // 4. Editor unlocking themself -> 403 (decision: only admins may unlock accounts)
tests/int/p2-t6.int.test.ts:844:      const editorUnlockSelf = await callJsonApi({
tests/int/p2-t6.int.test.ts:845:        method: 'POST',
tests/int/p2-t6.int.test.ts:846:        slugPath: ['users', 'unlock'],
tests/int/p2-t6.int.test.ts:847:        token: editorToken,
tests/int/p2-t6.int.test.ts:848:        body: { email: 'editor-p2t6@aljazira.co' },
tests/int/p2-t6.int.test.ts:849:      })
tests/int/p2-t6.int.test.ts:850:      expect(editorUnlockSelf.status).toBe(403)
tests/int/p2-t6.int.test.ts:852:      // Confirm the locked admin account is STILL locked after editor's rejected unlock attempt
tests/int/p2-t6.int.test.ts:853:      const loginStillLocked = await callJsonApi({
tests/int/p2-t6.int.test.ts:854:        method: 'POST',
tests/int/p2-t6.int.test.ts:855:        slugPath: ['users', 'login'],
tests/int/p2-t6.int.test.ts:856:        body: {
tests/int/p2-t6.int.test.ts:857:          email: lockedAdminEmail,
tests/int/p2-t6.int.test.ts:858:          password: lockedAdminPassword,
tests/int/p2-t6.int.test.ts:859:        },
tests/int/p2-t6.int.test.ts:860:      })
tests/int/p2-t6.int.test.ts:861:      expect(loginStillLocked.status).toBe(401)
tests/int/p2-t6.int.test.ts:863:      // 5. Admin unlocking the locked account -> 200, and subsequent login with valid password -> 200
tests/int/p2-t6.int.test.ts:864:      const adminUnlock = await callJsonApi({
tests/int/p2-t6.int.test.ts:865:        method: 'POST',
tests/int/p2-t6.int.test.ts:866:        slugPath: ['users', 'unlock'],
tests/int/p2-t6.int.test.ts:867:        token: adminToken,
tests/int/p2-t6.int.test.ts:868:        body: { email: lockedAdminEmail },
tests/int/p2-t6.int.test.ts:869:      })
tests/int/p2-t6.int.test.ts:870:      expect(adminUnlock.status).toBe(200)
tests/int/p2-t6.int.test.ts:872:      const loginAfterAdminUnlock = await callJsonApi({
tests/int/p2-t6.int.test.ts:873:        method: 'POST',
tests/int/p2-t6.int.test.ts:874:        slugPath: ['users', 'login'],
tests/int/p2-t6.int.test.ts:875:        body: {
tests/int/p2-t6.int.test.ts:876:          email: lockedAdminEmail,
tests/int/p2-t6.int.test.ts:877:          password: lockedAdminPassword,
tests/int/p2-t6.int.test.ts:878:        },
tests/int/p2-t6.int.test.ts:879:      })
tests/int/p2-t6.int.test.ts:880:      expect(loginAfterAdminUnlock.status).toBe(200)
tests/int/p2-t6.int.test.ts:881:    } finally {
tests/int/p2-t6.int.test.ts:882:      await payload.delete({
tests/int/p2-t6.int.test.ts:883:        collection: 'users',
tests/int/p2-t6.int.test.ts:884:        id: lockedAdmin.id,
tests/int/p2-t6.int.test.ts:885:        overrideAccess: true,
tests/int/p2-t6.int.test.ts:886:      })
tests/int/p2-t6.int.test.ts:887:    }
tests/int/p2-t6.int.test.ts:888:  })
