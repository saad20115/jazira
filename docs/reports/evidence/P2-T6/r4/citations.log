tests/int/p2-t6.int.test.ts:689:    expect(quoteDepth1AsEditor.status).toBe(200)
tests/int/p2-t6.int.test.ts:690:    const populatedAssignee = quoteDepth1AsEditor.body.assignedTo as Record<string, unknown>
tests/int/p2-t6.int.test.ts:691:    expect(populatedAssignee).toEqual({
